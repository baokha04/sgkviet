{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sgkviet",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sgkviet-db",
      "database_id": "6db1cea6-b81f-46fb-812c-5a7f9994546f",
      "migrations_dir": "migrations"
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "GOOGLE_AI_KEY",
      "store_id": "3dc321f4e8b846cd80ee85efaadbe707",
      "secret_name": "sgkviet-gateway_google-ai-studio_gemini"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTOR_INDEX",
      "index_name": "sgkviet-index"
    }
  ],

  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}

