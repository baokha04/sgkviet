{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sgkviet",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sgkviet-db",
      "database_id": "6db1cea6-b81f-46fb-812c-5a7f9994546f",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },

  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}

